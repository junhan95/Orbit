# Orbit 환경변수 — 복사해서 .env 로 쓰세요. .env 는 git 에 올라가지 않습니다.

# ── Claude ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_REVIEW_MODEL=claude-haiku-4-5

# ── 로그인 ─────────────────────────────────────────────
# 비워 두면 로컬 단일 사용자 모드(로그인 없음). 'oauth' 면 Google/GitHub 로그인 필수.
# AUTH_MODE=oauth
# AUTH_SECRET=            # openssl rand -base64 32
# APP_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── 로컬 모드 표시 이름 ────────────────────────────────
# LOCAL_USER_ID=local-user
# LOCAL_USER_NAME=로컬 사용자
# LOCAL_USER_EMAIL=local@orbit.test
