# orbitcrew 환경변수 — 복사해서 .env 로 쓰세요. .env 는 git 에 올라가지 않습니다.

# ── Claude ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_REVIEW_MODEL=claude-haiku-4-5

# ── 로그인 ─────────────────────────────────────────────
# 비워 두면 로컬 단일 사용자 모드(로그인 없음). 'oauth' 면 Google/GitHub 로그인 필수.
# AUTH_MODE=oauth
# AUTH_SECRET=            # openssl rand -base64 32
# APP_URL=http://localhost:3000
# LANDING_URL=                # 운영에서만: 루트 도메인(랜딩). 설정되면 랜딩/앱 호스트를 분리 (docs/deploy-cloudflare.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── 사용자 API 키(BYOK) 암호화 ────────────────────────
# OAuth 모드에서 사용자가 넣는 Anthropic 키를 AES-GCM 으로 저장할 때 쓰는 마스터 시크릿 (32자 이상)
# KEY_ENCRYPTION_SECRET=      # openssl rand -base64 32

# ── 로컬 모드 표시 이름 ────────────────────────────────
# LOCAL_USER_ID=local-user
# LOCAL_USER_NAME=로컬 사용자
# LOCAL_USER_EMAIL=local@orbit.test

# ── 크레딧 (docs/pricing-credits.md) ───────────────────
# 비워 두면 기본값. 배수 1.8, 환율 1400원/USD(월 1회 수동 갱신), 가입 체험 300 크레딧(1 크레딧 = 10원)
# CREDIT_MARKUP=1.8
# CREDIT_FX_RATE=1400
# CREDIT_TRIAL_CREDITS=300

# ── 토스페이먼츠 (크레딧 충전 결제, docs/pricing-credits.md §2) ──
# 개발자센터 > 내 개발정보 > API 키. 테스트 키는 test_ck_… / test_sk_… 로 시작합니다.
# 클라이언트 키는 브라우저에 노출되는 값이고, 시크릿 키는 서버(승인·취소 API)에서만 씁니다 — 배포에서는 wrangler secret put TOSS_SECRET_KEY.
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...
